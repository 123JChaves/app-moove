#!/bin/sh
echo "🧪 Executando testes automatizados E2E dentro do container Docker antes do push..."

# Usa 'run --rm' para subir o container temporariamente, rodar o teste e fechar sozinho
docker compose --profile front run --rm frontend npm run test:login:e2e || exit 1
docker compose --profile front run --rm frontend npm run test:cadastro:e2e || exit 1

echo "✅ Todos os testes passaram! Concluindo envio..."