# =====================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE - copie para ".env" e preencha
#   cp .env.example .env
# NUNCA versionar o .env real (já está no .gitignore)
# =====================================================================

# ---------- Bot WhatsApp (back-end) ----------
JWT_ID_BOTSECRET=
JWT_ID_GROUPSECRET=
JWT_ADMIN_ALT_ID=
JWT_ADMIN_REAL_PHONE=
JWT_ADMIN_SECRET=
JWT_ID_GRUPO_PASSAGEIROS_1=
JWT_ID_GRUPO_PASSAGEIROS_2=
JWT_ID_GRUPO_PASSAGEIROS_3=
JWT_ID_GRUPO_PASSAGEIROS_4=

# Chave de assinatura dos tokens de login (gere com: openssl rand -hex 32)
JWT_SECRET=

# ---------- MySQL (container db) ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=whatsapp_bot
MYSQL_USER=
MYSQL_PASSWORD=
# Porta para acessar o MySQL do Docker pelo DBeaver (somente 127.0.0.1)
MYSQL_PORTA_LOCAL=3307

# Usadas pelo TypeORM quando o back-end roda FORA do Docker
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=whatsapp_bot

# ---------- Redis (cache + Pub/Sub) ----------
# Dentro do Docker o compose já injeta REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true
CACHE_TTL_ROTAS=120
CACHE_TTL_EMPRESAS=600
CACHE_TTL_MOTORISTAS=60

# ---------- Microsserviço de auditoria (banco PRÓPRIO) ----------
AUDITORIA_DB_ROOT_PASSWORD=
AUDITORIA_DB_NAME=moove_auditoria
AUDITORIA_DB_USER=auditoria
AUDITORIA_DB_PASSWORD=
AUDITORIA_RETENCAO_DIAS=180
AUDITORIA_DB_PORTA_LOCAL=3308

# ---------- Observabilidade ----------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---------- Nginx ----------
# 8080/8443 evitam conflito com Apache/IIS/XAMPP na porta 80 do Windows
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# ---------- App mobile (Expo) ----------
REACT_NATIVE_PACKAGER_HOSTNAME=
EXPO_PUBLIC_IP_ONE=
EXPO_PUBLIC_IP_TWO=
EXPO_PUBLIC_URL_IMAGEM=
