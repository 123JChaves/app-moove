{
  "name": "jcha-project-root",
  "version": "1.0.0",
  "description": "Orquestrador centralizado do ecossistema WhatsApp Bot e React Native App",
  "main": "index.js",
  "scripts": {
    "docker:iniciar": "scripts\\iniciar.bat",
    "docker:infra": "docker compose up -d db redis db-auditoria",
    "docker:backend": "docker compose up backend",
    "docker:backend:bg": "docker compose up -d backend",
    "docker:auditoria": "docker compose up auditoria",
    "docker:auditoria:bg": "docker compose up -d auditoria",
    "docker:nginx": "docker compose up -d --no-deps nginx",
    "docker:frontend": "docker compose up frontend",
    "docker:ngrok": "npx ngrok http 127.0.0.1:8080",
    "docker:tudo": "docker compose up -d",
    "docker:rebuild": "docker compose up -d --build --renew-anon-volumes",
    "docker:parar": "docker compose stop",
    "docker:parar:backend": "docker compose stop backend",
    "docker:parar:auditoria": "docker compose stop auditoria",
    "docker:parar:frontend": "docker compose stop frontend",
    "docker:reiniciar:backend": "docker compose restart backend",
    "docker:reiniciar:auditoria": "docker compose restart auditoria",
    "docker:reiniciar:nginx": "docker compose restart nginx",
    "docker:status": "docker compose ps",
    "docker:diagnostico": "scripts\\diagnostico.bat",
    "docker:health": "curl -s http://127.0.0.1:8080/health/ready",
    "docker:health:auditoria": "curl -s http://127.0.0.1:8080/auditoria/health/ready",
    "docker:logs": "docker compose logs -f backend auditoria db redis nginx",
    "docker:logs:backend": "docker compose logs -f backend",
    "docker:logs:auditoria": "docker compose logs -f auditoria",
    "docker:logs:nginx": "docker compose logs -f nginx",
    "docker:sh:backend": "docker compose exec backend sh",
    "docker:sh:auditoria": "docker compose exec auditoria sh",
    "docker:sh:frontend": "docker compose exec frontend sh",
    "docker:migration": "docker compose exec backend npm run migration:run",
    "docker:mysql": "docker compose exec db sh -c \"mysql -uroot -p$MYSQL_ROOT_PASSWORD $MYSQL_DATABASE\"",
    "docker:mysql:auditoria": "docker compose exec db-auditoria sh -c \"mysql -u$MYSQL_USER -p$MYSQL_PASSWORD $MYSQL_DATABASE\"",
    "docker:redis": "docker compose exec redis redis-cli",
    "docker:redis:monitor": "docker compose exec redis redis-cli MONITOR",
    "docker:redis:eventos": "docker compose exec redis redis-cli PSUBSCRIBE \"moove.*\"",
    "docker:redis:chaves": "docker compose exec redis redis-cli --scan --pattern \"moove:*\"",
    "docker:test:login": "docker compose --profile front exec frontend npm run test:login:e2e",
    "docker:test:cadastro": "docker compose --profile front exec frontend npm run test:cadastro:e2e",
    "docker:test:jornada": "docker compose --profile front exec frontend npm run test:jornada:e2e",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:clean:APAGA-BANCOS": "docker system prune -a --volumes",
    "local:iniciar": "scripts\\iniciar-local.bat",
    "local:install": "cd whatsappBot && npm install && cd .. && cd jcha_app && npm install && cd .. && cd auditoria && npm install",
    "local:redis": "docker compose up -d redis",
    "local:backend": "cd whatsappBot && npm run dev",
    "local:auditoria": "cd auditoria && npm run dev",
    "local:frontend": "cd jcha_app && npm start",
    "local:ngrok": "npx ngrok http 127.0.0.1:8085",
    "local:health": "curl -s http://127.0.0.1:8085/health/ready",
    "local:health:auditoria": "curl -s http://127.0.0.1:8090/auditoria/health/ready",
    "local:migration": "cd whatsappBot && npm run migration:run",
    "local:test:login": "npm run test:login:e2e --prefix jcha_app",
    "local:test:cadastro": "npm run test:cadastro:e2e --prefix jcha_app",
    "local:test:jornada": "npm run test:jornada:e2e --prefix jcha_app",
    "test:backend": "cd whatsappBot && npm run test",
    "test:backend:watch": "cd whatsappBot && npm run test:watch",
    "test:auditoria": "cd auditoria && npm test",
    "prepare": "husky && husky install"
  },
  "keywords": [
    "docker",
    "expo",
    "react-native",
    "baileys",
    "whatsapp-bot",
    "typeorm"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "husky": "^8.0.0"
  }
}
