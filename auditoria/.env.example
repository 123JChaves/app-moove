# =====================================================================
# MICROSSERVIÇO DE AUDITORIA - execução LOCAL (sem Docker)
# No Docker estas variáveis vêm do docker-compose.yml e este arquivo é ignorado.
# =====================================================================
PORT=8090
# Mesmo JWT_SECRET do whatsappBot/.env (o token do /login precisa ser aceito aqui)
JWT_SECRET=
AUDITORIA_EXIGIR_JWT=true

# Banco PRÓPRIO do microsserviço no MySQL local (XAMPP). O database é criado sozinho.
AUDITORIA_DB_HOST=127.0.0.1
AUDITORIA_DB_PORT=3306
AUDITORIA_DB_USER=root
AUDITORIA_DB_PASSWORD=
AUDITORIA_DB_NAME=moove_auditoria

# Redis local: deixe false se não houver Redis rodando no Windows
# (true = recebe os eventos do back-end; use "npm run local:redis" para ter um Redis)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AUDITORIA_RETENCAO_DIAS=180
LOG_LEVEL=info
