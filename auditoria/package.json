{
  "name": "moove-auditoria",
  "version": "1.0.0",
  "description": "Microsserviço de auditoria do Moove: consome eventos de domínio (Redis Pub/Sub) e mantém o histórico em banco próprio.",
  "main": "dist/index.js",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --passWithNoTests --forceExit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.5",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
